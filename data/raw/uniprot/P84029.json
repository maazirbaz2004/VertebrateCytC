              "source": "PubMed",
              "id": "2987802"
            }
          ],
          "value": "Expressed at varying, but relatively high levels throughout development"
        }
      ],
      "commentType": "DEVELOPMENTAL STAGE"
    },
    {
      "texts": [
        {
          "value": "Binds 1 heme c group covalently per subunit"
        }
